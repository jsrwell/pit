{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/run.py",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "SERVER__RELOAD": "false"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Backend: pytest (arquivo atual)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Frontend: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Frontend: dev"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Backend: API", "Frontend: Chrome"],
      "preLaunchTask": "Database: up",
      "stopAll": true
    }
  ]
}
